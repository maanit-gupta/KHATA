# Copy to backend/.env for local dev. On Render, set these in the dashboard instead.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Used ONLY for POST /shops, POST /shops/join, Storage, and test setup.
SUPABASE_SECRET_KEY=sb_secret_...
SARVAM_API_KEY=
GROQ_API_KEY=
# Comma-separated: the Vercel URL + local Vite dev server
ALLOWED_ORIGINS=http://localhost:5173
